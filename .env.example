# Supabase public client configuration
# The publishable key is safe for browser use; RLS still controls data access.
VITE_SUPABASE_URL=https://ybhrmcdlgyccywpmiucz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase configuration
# Never prefix service role keys with VITE_; Vite exposes VITE_* values to browsers.
SUPABASE_URL=https://ybhrmcdlgyccywpmiucz.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Configuration
# Keep provider keys server-side. Browser AI calls must go through server routes/functions.
OPENAI_API_KEY=your-openai-key
VITE_AI_MODEL=gpt-4o

# WhatsApp Business API
# Keep access tokens server-side. Public pages may use wa.me links without this token.
WHATSAPP_API_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-id
VITE_WHATSAPP_PUBLIC_NUMBER=967782878280

# Payment Gateways
# Public keys are allowed in VITE_* only when configured in the provider dashboard with domain restrictions.
VITE_RAZORPAY_KEY=your-razorpay-public-key
VITE_STRIPE_PUBLIC_KEY=your-stripe-publishable-key

# Map Services
# Restrict browser API keys by HTTP referrer in the provider console.
VITE_GOOGLE_MAPS_API_KEY=your-restricted-maps-key

# Observability
VITE_SENTRY_DSN=your-sentry-dsn
VITE_GA4_ID=your-ga4-id

# Environment
VITE_APP_ENV=development
VITE_APP_NAME=MUSLLY AI OS
VITE_APP_VERSION=1.0.0

# MUSLLY AI OS Configuration
VITE_AI_SUN_VERSION=2.1
VITE_ENABLE_QUANTUM_MEMORY=true
VITE_SOVEREIGN_PROTOCOL=true
VITE_ENABLE_COSMIC_OS=true
VITE_ENABLE_SELF_HEALING=true
VITE_PERSISTENT_COSMIC_MODE=true
